# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# .NET build artifacts
bin/
obj/

# ArcGIS SDK assets (gerado via npm — não commitar, pesa ~20MB)
# Para regenerar: Copy-Item node_modules/@arcgis/core/assets public/arcgis-assets -Recurse
/public/arcgis-assets/

# Editor / IDE
.vscode/
.idea/

# Logs
*.log

# Antigravity AI assistant (dados locais do agente — não commitar)
.gemini/
